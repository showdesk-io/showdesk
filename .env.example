# =============================================================================
# Showdesk Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# Set to true to run migrations on deploy. Set to false for dry-run check.
RUN_MIGRATIONS=false
# Number of gunicorn workers (default: 4)
GUNICORN_WORKERS=4
# Number of celery worker processes (default: 4)
CELERY_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SUPERUSER_EMAIL=admin@showdesk.local
DJANGO_SUPERUSER_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://showdesk:showdesk@postgres:5432/showdesk
POSTGRES_DB=showdesk
POSTGRES_USER=showdesk
POSTGRES_PASSWORD=showdesk
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# S3-compatible Storage (MinIO for dev, Scaleway for prod)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:49000
S3_ACCESS_KEY_ID=showdesk
S3_SECRET_ACCESS_KEY=showdesk-secret
S3_BUCKET_NAME=showdesk-media
S3_REGION=us-east-1
S3_USE_SSL=False

# -----------------------------------------------------------------------------
# LiveKit (WebRTC / Screen Recording)
# -----------------------------------------------------------------------------
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# -----------------------------------------------------------------------------
# Video Processing
# -----------------------------------------------------------------------------
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_MAX_FILE_SIZE_MB=500
VIDEO_EXPIRATION_DAYS=90
VIDEO_THUMBNAIL_WIDTH=320
VIDEO_THUMBNAIL_HEIGHT=180

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# -----------------------------------------------------------------------------
# Domain (used by Caddy for TLS in production)
# -----------------------------------------------------------------------------
SHOWDESK_DOMAIN=localhost

# Public base URL used inside transactional emails (login link, dashboard
# link, join-request review link, etc.). Must be the URL your users will
# click — not an internal hostname. No trailing slash.
# Examples: http://localhost:40080 (dev), https://app.showdesk.io (prod)
SITE_URL=http://localhost:40080

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Origins allowed to call the API. The widget's routes answer any origin, so
# customers' sites don't belong here.
CORS_ALLOWED_ORIGINS=http://localhost:40080,https://localhost:40443

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# For dev (console output):
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For prod with Mailjet API:
#   EMAIL_BACKEND=anymail.backends.mailjet.EmailBackend
# For prod with a self-hosted Postal's API:
#   EMAIL_BACKEND=anymail.backends.postal.EmailBackend
# For prod with SMTP:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@showdesk.io

# Mailjet API (when using anymail.backends.mailjet.EmailBackend)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Postal API (when using anymail.backends.postal.EmailBackend): Postal's URL,
# e.g. https://postal.example.com, and an API credential of the Postal server
# to send with. Postal only sends from the verified domains of that server (or
# of its organization): add DEFAULT_FROM_EMAIL's domain and INBOUND_EMAIL_DOMAIN
# to it, with their SPF, DKIM and return path published.
ANYMAIL_POSTAL_API_URL=
ANYMAIL_POSTAL_API_KEY=

# SMTP (when using django.core.mail.backends.smtp.EmailBackend)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# -----------------------------------------------------------------------------
# Email channel (inbound mail)
# -----------------------------------------------------------------------------
# Domain receiving your organizations' forwarded support mail and the replies to
# tickets, e.g. inbound.example.com. Its MX must point to your inbound provider.
# Leave empty to keep the email channel off.
INBOUND_EMAIL_DOMAIN=
# Inbound mail reaches Showdesk through a signed webhook of your provider. With
# Postal, point its HTTP endpoint (base64 encoding) to
# https://<your domain>/anymail/postal/inbound/ and paste the server's public
# key here (the text between the BEGIN and END lines, on one line). The webhook
# only exists while this is set.
ANYMAIL_POSTAL_WEBHOOK_KEY=
# For providers other than Postal, whose webhooks Anymail checks by basic auth
# only: user:password (comma-separated to rotate). They are only mounted, under
# /anymail/<provider>/inbound/, while this is set. When set, Postal's webhook URL
# must carry it too (https://user:password@<your domain>/anymail/postal/inbound/).
ANYMAIL_WEBHOOK_SECRET=
# A resolved or closed ticket reopens on a reply within this many days of its
# last activity; a later reply opens a new ticket.
INBOUND_EMAIL_REOPEN_DAYS=7
# Total size, in MB, of the attachments kept from one mail. Attachments beyond it
# are dropped and noted in the message; the mail itself is kept. Only mail too
# large to be carried (about twice this size, once encoded by the provider) is
# refused. Raising it, raise the request_body max_size of /anymail/* in Caddy too.
INBOUND_EMAIL_MAX_SIZE_MB=25
# Mails per hour from one sender to one mailbox, beyond which they are ignored.
INBOUND_EMAIL_RATE_LIMIT_PER_HOUR=20
# Mails per hour to one mailbox, from anyone, beyond which they are ignored. A
# From costs nothing to change: this bounds what one mailbox can be sent.
INBOUND_EMAIL_MAILBOX_RATE_LIMIT_PER_HOUR=200
# Days the received raw mails (.eml) are kept.
INBOUND_EMAIL_RAW_RETENTION_DAYS=30
# Days the log of received mails is kept (pending and failed ones stay).
INBOUND_EMAIL_LOG_RETENTION_DAYS=90
# Minutes after which a reply still unread in the widget is also sent by email.
# Keep it below the broker's visibility timeout (one hour with Redis), or the
# scheduled mail may be delivered twice; values above 55 count as 55.
WIDGET_UNREAD_EMAIL_DELAY_MINUTES=5
# Size, in MB as sent (base64 adds a third), of the files an agent's reply mail
# attaches in all. The others are named in the mail, with the conversation link.
# Keep it below what your mail provider accepts per message.
REPLY_EMAIL_ATTACHMENTS_MAX_MB=10
# Days a conversation link sent by email stays valid.
CONVERSATION_LINK_MAX_AGE_DAYS=30
# Rate limits on the conversation page those links open, per client IP, as
# <number>/<second|minute|hour|day>: reading (the page polls every 15 s while
# visible), posting messages and files, and asking for a new link (each ticket
# gets at most one new link an hour, whatever this rate).
CONVERSATION_READ_RATE=60/minute
CONVERSATION_WRITE_RATE=20/minute
CONVERSATION_RENEW_RATE=10/hour

# -----------------------------------------------------------------------------
# Sending domains: replies from an organization's own address
# -----------------------------------------------------------------------------
# Once an organization has verified a domain and published the records below,
# its mailboxes' replies go out from their public address (support@acme.com)
# instead of their inbound address. Who sets the domains up for sending:
#   none          the feature is off and hidden;
#   manual        your own sending service (Postal, OpenDKIM, Haraka...), which
#                 must relay for any domain and sign each with one DKIM key;
#                 Showdesk shows the records and checks them in the DNS;
#   scaleway_tem  Scaleway Transactional Email, through its API;
#   mailjet       Mailjet, through its API (see below);
#   postal        a server of your own Postal, through the Postal domains
#                 service run next to it (see below).
# Changing the provider makes every domain set up under the previous one fall
# back to the inbound address: its admins must set it up again. Registrations
# the previous one holds (scaleway_tem, mailjet, postal) are removed once it is
# configured again.
SENDING_DOMAIN_PROVIDER=none
# manual: the SPF include of your sending service, e.g. spf.mail.example.net.
# Customers add include:<this> to their domain's SPF record.
SENDING_DOMAIN_SPF_INCLUDE=
# manual: the selector of your DKIM key. Publish the key once at
# <selector>._domainkey.<INBOUND_EMAIL_DOMAIN>, and have your sending service
# relay for every customer domain and sign each with that key: customers point
# <selector>._domainkey.<their domain> to it with a CNAME, which Showdesk checks.
# Showdesk registers nothing with your service. Also needs INBOUND_EMAIL_DOMAIN.
# These records are the same for every organization, so they prove nothing
# about who published them: with every provider, sending also needs the
# organization's own TXT record _showdesk.<domain> = showdesk-verification=<token>,
# shown first and checked at every check.
SENDING_DOMAIN_DKIM_SELECTOR=
# scaleway_tem: an API secret key restricted to Transactional Email (it never
# needs more), the id of the project the domains are registered in, and the
# region of that project. Showdesk registers, checks and revokes the domains.
SCW_TEM_SECRET_KEY=
SCW_TEM_PROJECT_ID=
SCW_TEM_REGION=fr-par
# mailjet: Showdesk registers each domain as a sender of the Mailjet account
# of MAILJET_API_KEY and MAILJET_SECRET_KEY above, shows the records Mailjet
# asks for, and has Mailjet validate and check them. Mailjet only sends from
# senders of its own account, so outbound mail must go through that same
# account: EMAIL_BACKEND=anymail.backends.mailjet.EmailBackend with the same
# keys. INBOUND_EMAIL_DOMAIN must be a validated sender domain of that account
# too, since fallback mail is sent from it. MAILJET_API_URL is the account's
# API host: https://api.us.mailjet.com for a US account. A wrong host makes
# every Mailjet call fail: domains can't be set up and checks never conclude.
# A Mailjet account holds at most 100 senders (deleted ones aside): about 100
# customer domains per account. Use one Mailjet account (or sub-account) per
# Showdesk instance: never share it between instances (e.g. dev and prod), as
# each would take the other's senders for its own. The instance's own domains
# (DEFAULT_FROM_EMAIL's, SITE_URL's host, INBOUND_EMAIL_DOMAIN and its
# subdomains) are never used to send from organizations' domains settings.
MAILJET_API_URL=https://api.mailjet.com
# postal: Postal has no API for domains, so run the Postal domains service
# (deploy/postal-domains/README.md) on the Postal host, behind its reverse
# proxy. It adds each domain to one Postal server, already verified (Showdesk
# proves the ownership itself), with its own DKIM key; Showdesk shows the SPF
# include, the DKIM record and the return-path CNAME, has Postal check them
# and checks them in the DNS itself. POSTAL_DOMAINS_API_URL is the service's
# URL, e.g. https://postal.example.com/showdesk-domains, and
# POSTAL_DOMAINS_API_TOKEN its POSTAL_DOMAINS_TOKEN (32 characters at least).
# Postal only sends from domains of the server it sends with: outbound mail
# must go through that same server (EMAIL_BACKEND=anymail.backends.postal.EmailBackend
# with ANYMAIL_POSTAL_API_URL and an API credential of that server in
# ANYMAIL_POSTAL_API_KEY). The instance's own From domains (DEFAULT_FROM_EMAIL's
# and INBOUND_EMAIL_DOMAIN, fallback mail being sent from it) are never managed
# by Showdesk: add them to that server yourself, verified, with their SPF, DKIM
# and return path published. Keep that server for Showdesk alone and one per
# Showdesk instance (never shared between dev and prod): a domain it already
# has is taken as Showdesk's. Your Postal host also needs what any mail server
# does: a PTR record matching its SMTP hostname, the SPF record of Postal's
# dns.spf_include listing its addresses, and Postal's own DKIM key and return
# path domain published.
POSTAL_DOMAINS_API_URL=
POSTAL_DOMAINS_API_TOKEN=

# -----------------------------------------------------------------------------
# OTP
# -----------------------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
# Wrong submissions a code survives before it stops working. Counted in the
# database, so this holds even while Redis is down.
OTP_MAX_ATTEMPTS=5
# Rate limits on one-time codes, as <number>/<second|minute|hour|day>. Requested
# and verified codes count separately, per client IP and per email address.
# Counted in Redis: while it is down they are not enforced and an error is logged.
OTP_REQUEST_IP_RATE=30/hour
OTP_REQUEST_EMAIL_RATE=5/hour
OTP_VERIFY_IP_RATE=60/hour
OTP_VERIFY_EMAIL_RATE=10/hour
# The same for the code a widget visitor asks for to prove their email and see
# their conversations by email. Counted apart from login codes, per client IP and
# per address of the widget session.
WIDGET_EMAIL_CODE_IP_RATE=30/hour
WIDGET_EMAIL_CODE_EMAIL_RATE=5/hour
WIDGET_EMAIL_VERIFY_IP_RATE=60/hour
WIDGET_EMAIL_VERIFY_EMAIL_RATE=10/hour

# -----------------------------------------------------------------------------
# Client IP detection
# -----------------------------------------------------------------------------
# How many reverse proxies you run in front of the backend. Per-IP rate limits
# use this to tell the client's address from what X-Forwarded-For contains.
#   0      No proxy: clients connect directly. X-Forwarded-For is ignored.
#   1, 2…  That many proxies: count this many entries from the end of the header.
#          With the bundled Caddy and nothing in front of it, that is 1.
#   empty  Don't count: use the whole header if there is one, otherwise the
#          connection's address. Works in any setup, but anyone who can get a
#          chosen X-Forwarded-For through can dodge the per-IP limits, so prefer
#          an explicit number.
# Count exactly: too low (0 behind a proxy) puts all your users behind one address
# and one limit; too high lets clients choose the address the limit applies to.
DRF_NUM_PROXIES=

# -----------------------------------------------------------------------------
# AI Features (off by default for self-hosted)
# -----------------------------------------------------------------------------
AI_ENABLED=False
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
# Optional: external AI API keys (user-provided)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_AI_TRANSCRIPTION=False
FEATURE_AI_TRIAGE=False
FEATURE_AI_SMART_REDACTION=False
FEATURE_AI_SENTIMENT_ANALYSIS=False

# -----------------------------------------------------------------------------
# Telemetry (opt-in only)
# -----------------------------------------------------------------------------
TELEMETRY_ENABLED=False
TELEMETRY_ENDPOINT=

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=ws://localhost:40080/ws
VITE_LIVEKIT_URL=ws://localhost:47880

# -----------------------------------------------------------------------------
# Widget
# -----------------------------------------------------------------------------
WIDGET_API_BASE_URL=/api/v1
