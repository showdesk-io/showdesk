# =============================================================================
# Showdesk Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# Set to true to run migrations on deploy. Set to false for dry-run check.
RUN_MIGRATIONS=false
# Number of gunicorn workers (default: 4)
GUNICORN_WORKERS=4
# Number of celery worker processes (default: 4)
CELERY_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SUPERUSER_EMAIL=admin@showdesk.local
DJANGO_SUPERUSER_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://showdesk:showdesk@postgres:5432/showdesk
POSTGRES_DB=showdesk
POSTGRES_USER=showdesk
POSTGRES_PASSWORD=showdesk
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# S3-compatible Storage (MinIO for dev, Scaleway for prod)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:49000
S3_ACCESS_KEY_ID=showdesk
S3_SECRET_ACCESS_KEY=showdesk-secret
S3_BUCKET_NAME=showdesk-media
S3_REGION=us-east-1
S3_USE_SSL=False

# -----------------------------------------------------------------------------
# LiveKit (WebRTC / Screen Recording)
# -----------------------------------------------------------------------------
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# -----------------------------------------------------------------------------
# Video Processing
# -----------------------------------------------------------------------------
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_MAX_FILE_SIZE_MB=500
VIDEO_EXPIRATION_DAYS=90
VIDEO_THUMBNAIL_WIDTH=320
VIDEO_THUMBNAIL_HEIGHT=180

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# -----------------------------------------------------------------------------
# Domain (used by Caddy for TLS in production)
# -----------------------------------------------------------------------------
SHOWDESK_DOMAIN=localhost

# Public base URL used inside transactional emails (login link, dashboard
# link, join-request review link, etc.). Must be the URL your users will
# click — not an internal hostname. No trailing slash.
# Examples: http://localhost:40080 (dev), https://app.showdesk.io (prod)
SITE_URL=http://localhost:40080

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:40080,https://localhost:40443

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# For dev (console output):
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For prod with Mailjet API:
#   EMAIL_BACKEND=anymail.backends.mailjet.EmailBackend
# For prod with SMTP:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@showdesk.io

# Mailjet API (when using anymail.backends.mailjet.EmailBackend)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# SMTP (when using django.core.mail.backends.smtp.EmailBackend)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# -----------------------------------------------------------------------------
# OTP
# -----------------------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
# Wrong submissions a code survives before it stops working. Counted in the
# database, so this holds even while Redis is down.
OTP_MAX_ATTEMPTS=5
# Rate limits on one-time codes, as <number>/<second|minute|hour|day>. Requested
# and verified codes count separately, per client IP and per email address.
# Counted in Redis: while it is down they are not enforced and an error is logged.
OTP_REQUEST_IP_RATE=30/hour
OTP_REQUEST_EMAIL_RATE=5/hour
OTP_VERIFY_IP_RATE=60/hour
OTP_VERIFY_EMAIL_RATE=10/hour

# -----------------------------------------------------------------------------
# Client IP detection
# -----------------------------------------------------------------------------
# How many reverse proxies you run in front of the backend. Per-IP rate limits
# use this to tell the client's address from what X-Forwarded-For contains.
#   0      No proxy: clients connect directly. X-Forwarded-For is ignored.
#   1, 2…  That many proxies: count this many entries from the end of the header.
#          With the bundled Caddy and nothing in front of it, that is 1.
#   empty  Don't count: use the whole header if there is one, otherwise the
#          connection's address. Works in any setup, but anyone who can get a
#          chosen X-Forwarded-For through can dodge the per-IP limits, so prefer
#          an explicit number.
# Count exactly: too low (0 behind a proxy) puts all your users behind one address
# and one limit; too high lets clients choose the address the limit applies to.
DRF_NUM_PROXIES=

# -----------------------------------------------------------------------------
# AI Features (off by default for self-hosted)
# -----------------------------------------------------------------------------
AI_ENABLED=False
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
# Optional: external AI API keys (user-provided)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_AI_TRANSCRIPTION=False
FEATURE_AI_TRIAGE=False
FEATURE_AI_SMART_REDACTION=False
FEATURE_AI_SENTIMENT_ANALYSIS=False

# -----------------------------------------------------------------------------
# Telemetry (opt-in only)
# -----------------------------------------------------------------------------
TELEMETRY_ENABLED=False
TELEMETRY_ENDPOINT=

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=ws://localhost:40080/ws
VITE_LIVEKIT_URL=ws://localhost:47880

# -----------------------------------------------------------------------------
# Widget
# -----------------------------------------------------------------------------
WIDGET_API_BASE_URL=/api/v1
