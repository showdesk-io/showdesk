# Showdesk - Development Caddyfile
#
# Single entry point for the entire stack.
# In dev: http://localhost (port 80), no TLS.
# Caddy routes requests to the correct upstream service.

{
	# Disable automatic HTTPS in development
	auto_https off
}

:80 {
	# -----------------------------------------------------------------------
	# API + Admin + Static backend routes → Django (Daphne)
	# -----------------------------------------------------------------------
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /admin/* {
		reverse_proxy backend:8000
	}

	handle /static/* {
		reverse_proxy backend:8000
	}

	# Inbound mail webhooks (email channel). The backend refuses a body over
	# about 2 x INBOUND_EMAIL_MAX_SIZE_MB (25 by default), but only once it is
	# received: this bounds what is read. Raise it with INBOUND_EMAIL_MAX_SIZE_MB.
	handle /anymail/* {
		request_body {
			max_size 50MB
		}
		reverse_proxy backend:8000
	}

	# -----------------------------------------------------------------------
	# WebSocket → Django Channels (Daphne)
	# -----------------------------------------------------------------------
	handle /ws/* {
		reverse_proxy backend:8000
	}

	# -----------------------------------------------------------------------
	# MinIO S3 API (presigned URLs, direct uploads)
	# -----------------------------------------------------------------------
	handle /s3/* {
		uri strip_prefix /s3
		reverse_proxy minio:9000
	}

	# -----------------------------------------------------------------------
	# Mailpit (dev email UI)
	# -----------------------------------------------------------------------
	handle /mailpit/* {
		reverse_proxy mailpit:8025
	}

	# -----------------------------------------------------------------------
	# Widget (dev server with hot reload)
	# -----------------------------------------------------------------------
	handle /cdn/* {
		uri strip_prefix /cdn
		reverse_proxy widget:3001
	}

	handle /widget-demo* {
		rewrite /widget-demo /widget-demo.html
		reverse_proxy widget:3001
	}

	# -----------------------------------------------------------------------
	# Conversation page: its URL holds its link's token, no Referer may carry it
	# -----------------------------------------------------------------------
	handle /c/* {
		header Referrer-Policy no-referrer
		reverse_proxy frontend:5173
	}

	# -----------------------------------------------------------------------
	# Everything else → React frontend (Vite dev server)
	# -----------------------------------------------------------------------
	handle {
		reverse_proxy frontend:5173
	}
}
